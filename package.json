{
  "name": "schemock",
  "version": "1.1.2",
  "scripts": {
    "dev": "bun --watch server/index.ts",
    "build": "bun build ./server/index.ts --outdir ./dist --minify --splitting --sourcemap --target bun",
    "start": "bun run dist/index.js",
    "format": "bunx prettier --write \"server/**/*.ts\"",
    "test": "cd server && bun vitest run",
    "test:watch": "cd server && bun vitest",
    "test:ui": "cd server && bun vitest --ui",
    "test:coverage": "cd server && bun vitest run --coverage",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "client:dev": "cd client && bun run dev",
    "client:build": "cd client && bun run build",
    "client:preview": "cd client && bun run preview",
    "dev:all": "concurrently --kill-others \"bun run dev\" \"bun run client:dev\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint server",
    "check": "bun run lint && bun run typecheck && bun run test && cd client && bun run lint && bun run build"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@scalar/hono-api-reference": "^0.12.11",
    "csv-writer": "^1.6.0",
    "fuse.js": "^7.5.0",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "zod": "^4.6.5",
    "@faker-js/faker": "^10.6.0",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vitest/ui": "^5.0.3",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.71.1",
    "globals": "^17.13.0",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.13.0"
  },
  "type": "module"
}
